# MySQL connection. Use a dedicated database user instead of root in production.
DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/undangyuk
DB_CONNECTION_LIMIT=10

# Generate a unique random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Used by npm run db:seed to create the initial administrator and sample invitation.
SEED_ADMIN_NAME=Admin UndangYuk
SEED_ADMIN_EMAIL=admin@undangyuk.local
SEED_ADMIN_PASSWORD=change-this-admin-password
